# Project style for the Paper 1 figures (ACM CSUR, acmsmall, text width 395.8 pt = 5.477 in).
# Sizes are set for final print size: no figure is rescaled in LaTeX, so 7 pt here is 7 pt on the page.
font.family: Arial, DejaVu Sans
font.size: 7.5
axes.titlesize: 8
axes.labelsize: 7.5
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
legend.frameon: False
axes.linewidth: 0.6
axes.spines.top: False
axes.spines.right: False
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.major.size: 2.5
ytick.major.size: 2.5
lines.linewidth: 1.0
lines.markersize: 4.5
savefig.dpi: 300
pdf.fonttype: 42
ps.fonttype: 42
mathtext.fontset: dejavusans
text.usetex: False
figure.dpi: 150
